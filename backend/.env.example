# Required. There is no default: a missing DATABASE_URL fails at boot rather
# than letting the app start against an unintended database.
DATABASE_URL=postgresql+psycopg2://activity:activity@localhost:5432/activity_hub

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reject uploads larger than this (bytes). 20 MiB covers a very long TCX.
# Whole request bodies are capped at this plus 1 MiB of multipart framing.
MAX_UPLOAD_BYTES=20971520

# Export archives. A zip needs a far larger cap than a single activity, and its
# own guards: XML compresses about ten to one, so 200 MiB of zip can honestly
# claim to be gigabytes of XML — which is also what a zip bomb looks like.
MAX_ARCHIVE_BYTES=209715200
MAX_ARCHIVE_MEMBERS=5000
MAX_ARCHIVE_EXTRACTED_BYTES=2147483648
# Files reported individually in the response. The counts are always exact.
MAX_REPORTED_MEMBERS=200
# A running archive import that has not finished a file in this many seconds is
# reported as interrupted (its worker is gone, most likely by a restart).
ARCHIVE_IMPORT_STALE_SECONDS=300

# IANA timezone used to bucket activities whose file states no UTC offset.
DISPLAY_TIMEZONE=Europe/Rome

# Activities from the same user starting within this many seconds, in the same
# sport, are treated as one session exported twice.
DUPLICATE_WINDOW_SECONDS=300

# Only used by scripts.ensure_user, for headless setups that never open the
# dashboard. Normally the first-run screen asks who you are instead.
DEFAULT_FIRST_NAME=Athlete
# DEFAULT_LAST_NAME=

# Hard ceiling on track points returned by one request, whatever max_points asks.
MAX_TRACK_POINTS=20000

# Verbose SQL echo and tracebacks. Never enable in production: it logs data.
DEBUG=false
